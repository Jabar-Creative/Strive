# Nest & Next butuh resolusi peer yang longgar.
strict-peer-dependencies=false
auto-install-peers=true

# pnpm >= 10 menjalankan `pnpm install` implisit sebelum SETIAP script.
# Dengan `pnpm dev` (tiga script paralel lewat concurrently) itu berarti tiga
# install serentak yang saling rebutan .git/config lewat hook husky, dan
# salah satunya mati. Verifikasi dependensi dilakukan eksplisit: `pnpm i`.
verify-deps-before-run=false

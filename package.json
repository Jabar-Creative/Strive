{
  "name": "strive-academy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "db:migrate": "node scripts/not-implemented.mjs db:migrate F-04",
    "db:types": "node scripts/not-implemented.mjs db:types F-04",
    "seed": "node scripts/not-implemented.mjs seed F-04",
    "seed:content": "node scripts/not-implemented.mjs seed:content F-11",
    "dev": "concurrently -k -n web,api,ai -c cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:ai\"",
    "dev:web": "pnpm --filter @strive/web dev",
    "dev:api": "pnpm --filter @strive/api dev",
    "dev:worker": "pnpm --filter @strive/api dev:worker",
    "dev:ai": "node scripts/dev-ai.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e R-01",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}

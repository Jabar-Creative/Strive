# ═══════════════════════════════════════════════════════════════════════════
#  Strive Academy — contoh environment
#  Salin: cp .env.example .env
#
#  Seluruh variabel di docs/PRD.md §19.2 ada di sini, satu per satu.
#  Nilai di bawah aman untuk DEV LOKAL saja. JANGAN pernah commit .env.
# ═══════════════════════════════════════════════════════════════════════════

# ── Proses (docs/PRD.md §19.2) ─────────────────────────────────────────────
MODE=api                                               # api | worker — satu image, dua peran
WEB_PORT=3000                                          # Next.js
API_PORT=3001                                          # NestJS
AI_SERVICE_PORT=8000                                   # FastAPI

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development                                   # development | production
APP_URL=http://localhost:3000                          # URL web app (Next.js)
API_URL=http://localhost:3001                          # URL Core API (NestJS)

# Port PostgreSQL digeser ke 55432 agar tidak bentrok dengan Postgres lokal.
DATABASE_URL=postgres://strive:strive_dev_only@localhost:55432/strive
# Port Redis digeser ke 56379 dengan alasan yang sama.
REDIS_URL=redis://localhost:56379

# ── Auth ───────────────────────────────────────────────────────────────────
# WAJIB >= 32 byte (docs/PRD.md §16.1). Sengaja DIKOSONGKAN: repo ini publik,
# jadi nilai contoh apa pun di sini otomatis diketahui semua orang. Isi sendiri
# di .env milikmu: `openssl rand -base64 48`
#
# ACCESS_TOKEN_TTL / REFRESH_TOKEN_TTL dihapus di A-03: isu #18 mengganti AU-4
# dari "JWT 15 menit + refresh dirotasi" menjadi sesi server Better-Auth 30
# hari — tidak ada token yang TTL-nya bisa disetel dari env lagi.
AUTH_SECRET=

# ── Web ────────────────────────────────────────────────────────────────────
# Basis URL API untuk browser (A-03). NEXT_PUBLIC_ agar ter-inline ke bundle
# client Next.js; kosong berarti fallback http://localhost:3001 di kode.
NEXT_PUBLIC_API_URL=

# ── Storage (MinIO di dev, S3-compatible di produksi) ──────────────────────
# `S3_REGION` wajib ada untuk SDK AWS meski MinIO mengabaikannya (K-01).
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:59000
S3_BUCKET_DOCUMENTS=strive-documents                   # privat — skripsi & CV pengguna
S3_BUCKET_ASSETS=strive-assets                         # privat — aset store
S3_ACCESS_KEY=strive
S3_SECRET_KEY=strive_dev_only

# ── Payment — Midtrans Snap hosted (docs/PRD.md §12.1) ─────────────────────
# Koin HANYA ditambahkan dari webhook bertanda tangan, tidak pernah dari
# redirect client. SERVER_KEY dipakai memverifikasi SHA512 signature.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Plagiarisme — Copyleaks (docs/PRD.md §12.2) ────────────────────────────
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_WEBHOOK_SECRET=

# ── LLM (docs/PRD.md §12.3) ────────────────────────────────────────────────
# PASANG HARD LIMIT BIAYA DI DASHBOARD VENDOR SEJAK HARI PERTAMA,
# bukan setelah tagihan pertama.
LLM_PROVIDER=openai                                    # openai | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o                                       # gpt-4o untuk CV, -mini untuk feedback
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=                                      # hanya Core API boleh memanggil AI service

# ── Email — Resend (docs/PRD.md §12.4) ─────────────────────────────────────
# Sejak isu #65 ini BUKAN cuma untuk email notifikasi: reset password dan
# verifikasi email auth memakai pengirim yang sama. Kosong = registrasi dan
# login TETAP jalan (kegagalan kirim sengaja tidak menggagalkan alurnya), tapi
# tidak ada yang bisa memulihkan password, dan `users.email_verified` tidak
# pernah jadi true — yang berarti top-up terblokir untuk semua orang (AU-8).
RESEND_API_KEY=
EMAIL_FROM=Strive Academy <no-reply@localhost>

# ── Observability (docs/PRD.md §17) ────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info                                         # error | warn | info | debug

# ── Feature flag — kill switch tanpa deploy (docs/PRD.md §19.3) ────────────
FEATURE_SCAN_ENABLED=true                              # vendor down -> matikan tombol scan
FEATURE_MASTERY_ENABLED=true                           # fitur preview
FEATURE_WS_ENABLED=true                                # WS bermasalah -> paksa polling

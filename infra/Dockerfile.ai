# services/ai — FastAPI.
# Dibangun dari ROOT repo:  docker build -f infra/Dockerfile.ai .
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

FROM base AS deps
COPY services/ai/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

FROM deps AS runtime
RUN useradd --create-home --uid 10001 strive
COPY --chown=strive:strive services/ai/app ./app
COPY --chown=strive:strive services/ai/pyproject.toml ./
USER strive
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

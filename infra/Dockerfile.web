# apps/web — Next.js 15, standalone output.
# Dibangun dari ROOT repo:  docker build -f infra/Dockerfile.web .
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json           apps/web/
COPY packages/ui/package.json        packages/ui/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile --filter @strive/web...

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
# `standalone` hanya menyala di sini — lihat komentar di apps/web/next.config.mjs.
ENV DOCKER_BUILD=1
RUN pnpm --filter @strive/web build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S strive && adduser -S strive -G strive
COPY --from=build --chown=strive:strive /repo/apps/web/.next/standalone ./
COPY --from=build --chown=strive:strive /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=strive:strive /repo/apps/web/public ./apps/web/public
USER strive
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

# apps/web — Next.js 15, standalone output.
# Dibangun dari ROOT repo:  docker build -f infra/Dockerfile.web .
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json           apps/web/
COPY packages/ui/package.json        packages/ui/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile --filter @strive/web...

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
# `standalone` hanya menyala di sini — lihat komentar di apps/web/next.config.mjs.
ENV DOCKER_BUILD=1
# `NEXT_PUBLIC_*` DI-INLINE KE BUNDLE SAAT BUILD, bukan dibaca saat runtime.
# Tanpa ARG ini, image apa pun yang dibangun di sini membawa fallback
# `http://localhost:3001` selamanya, dan menyetel variabelnya di runtime tidak
# mengubah satu byte pun di bundle yang sudah jadi. Gejalanya: halaman terbuka
# normal lalu setiap panggilan API menembak localhost milik BROWSER pengguna.
#
# Staging tidak memakai berkas ini (web dibangun Vercel — lihat infra/README.md),
# jadi yang dijaga ARG ini adalah build Docker lokal dan pemakaian berikutnya.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @strive/web build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S strive && adduser -S strive -G strive
COPY --from=build --chown=strive:strive /repo/apps/web/.next/standalone ./
COPY --from=build --chown=strive:strive /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=strive:strive /repo/apps/web/public ./apps/web/public
USER strive
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

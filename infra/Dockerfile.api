# apps/api — NestJS. SATU image, dua peran: MODE=api | MODE=worker.
# Dibangun dari ROOT repo:  docker build -f infra/Dockerfile.api .
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/api/package.json           apps/api/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile --filter @strive/api...

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @strive/api build && pnpm prune --prod

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
ENV MODE=api
# cwd HARUS `apps/api`, sama seperti skrip `start` (`node dist/main.js`).
#
# pnpm isolated tidak mengangkat paket ke `node_modules` root. Yang dipakai
# proses adalah symlink relatif terhadap kedalaman repo:
#   apps/api/node_modules/reflect-metadata
#     -> ../../../node_modules/.pnpm/reflect-metadata@…/node_modules/reflect-metadata
#   apps/api/node_modules/@strive/contracts
#     -> ../../../../packages/contracts
# Menaruh `dist` di `/app/dist` dan modul di `/app/apps/api/node_modules`
# membuat Node, yang berjalan dari `/app/dist/main.js`, hanya mencari
# `/app/node_modules`. Di situ tidak ada `reflect-metadata` — hanya toko
# `.pnpm`. Container staging crash-loop `MODULE_NOT_FOUND` sebelum `/health`
# pernah menjawab (run 36114955174).
WORKDIR /repo/apps/api
RUN addgroup -S strive && adduser -S strive -G strive
COPY --from=build --chown=strive:strive /repo/node_modules          /repo/node_modules
COPY --from=build --chown=strive:strive /repo/apps/api/node_modules /repo/apps/api/node_modules
COPY --from=build --chown=strive:strive /repo/apps/api/dist         /repo/apps/api/dist
COPY --from=build --chown=strive:strive /repo/apps/api/package.json /repo/apps/api/package.json
COPY --from=build --chown=strive:strive /repo/packages              /repo/packages
USER strive
EXPOSE 3001
# MODE=worker menjalankan pool BullMQ dari image yang sama (lihat src/main.ts).
CMD ["node", "dist/main.js"]
